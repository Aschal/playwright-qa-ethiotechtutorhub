{
  "name": "etth-qa-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript QA suite for EthioTechTutor Hub: course search, whole-site checks, accessibility, API and k6",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium --project=mobile-chrome",
    "test:a11y": "playwright test --project=a11y",
    "test:smoke": "playwright test --grep @smoke",
    "typecheck": "tsc",
    "report": "playwright show-report",
    "test:site": "playwright test --project=site",
    "test:ui": "playwright test --ui",
    "lint": "eslint .",
    "list": "playwright test --list"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-playwright": "^2.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "private": true
}
